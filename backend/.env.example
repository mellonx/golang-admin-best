# 服务配置
SERVER_PORT=8080
SERVER_MODE=debug

# 默认数据库配置
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=golang_admin_best
DB_CHARSET=utf8mb4
DB_MAX_IDLE=10
DB_MAX_OPEN=100

# 多数据库连接示例（如需从库/多租户，在 config.go 的 DB map 中添加对应配置项）
# DB_SLAVE_HOST=127.0.0.1
# DB_SLAVE_PORT=3306
# ...

# JWT 配置
JWT_SECRET=art-design-pro-secret-change-in-production
JWT_EXPIRE_HOURS=24
JWT_REFRESH_EXPIRE_HOURS=168
